      "placeholder": {
        "en": "Nickname",
        "nl": "Bijnaam"
      }
    }
  ],
  "tokens": [
    {
      "name": "nickname",
      "type": "string",
      "title": {
        "en": "Nickname",
        "nl": "Bijnaam"
      },
      "example": {
        "en": "Stefan",
        "nl": "Stefan"
      }
    },
    {
      "name": "channel",
      "type": "string",
      "title": {
        "en": "Channel",
        "nl": "Kanaal"
      },
      "example": {
        "en": "Lobby",
        "nl": "Lobby"
      }
    },
    {
      "name": "online_minutes",
      "type": "number",
      "title": {
        "en": "Minutes online",
        "nl": "Minuten online"
      },
      "example": 95
    },
    {
      "name": "online_users",
      "type": "number",
      "title": {
